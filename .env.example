# ---- Required for initial deployment ----
NEXT_PUBLIC_SITE_URL=https://your-vercel-project.vercel.app
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# ---- Optional ----
# Server-only. Lets admins create editor accounts from Admin → Settings. NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Optional email notifications for new inquiries (only active when BOTH are set).
RESEND_API_KEY=
NOTIFY_TO_EMAIL=
# Optional sender for Resend (must be a verified domain/address). Defaults to onboarding@resend.dev for testing.
NOTIFY_FROM_EMAIL=
